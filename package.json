{
  "name": "fadhlidev-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "dockerize": "bun run scripts/dockerize.ts",
    "start": "bun run scripts/start.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "migrate:generate": "drizzle-kit generate",
    "migrate:up": "bun run \"app/(storage)/database/helpers/migrate.ts\"",
    "migrate:down": "drizzle-kit drop && drizzle-kit generate && bun run \"app/(storage)/database/helpers/migrate.ts\"",
    "seed": "bun run \"app/(storage)/database/helpers/seed.ts\""
  },
